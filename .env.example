# PostgreSQL Connection (Use Direct/Session connection port 5432, NOT 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication Session Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=""

# 32-byte Base64 AES key for student phone encryption (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
PHONE_ENCRYPTION_KEY=""

# Base64 HMAC key for phone lookup hashing (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
PHONE_HASH_KEY=""

# Environment
NODE_ENV="production"
